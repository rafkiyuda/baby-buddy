generator client {
  provider = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  PARENT
  GUARDIAN
}

enum ProfileType {
  CHILD
}

enum Gender {
  MALE
  FEMALE
}

enum TransactionStatus {
  PENDING
  COMPLETED
  FAILED
}

enum TransactionType {
  TOKEN_PURCHASE
  SUBSCRIPTION
  MARKETPLACE_ORDER
}

model User {
  id           String        @id @default(uuid())
  username     String        @unique
  email        String?       @unique
  password     String
  role         Role          @default(PARENT)
  tokenBalance Int           @default(0) @map("token_balance")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")
  
  profiles     Profile[]
  transactions Transaction[]
  cart         Cart?

  @@map("users")
}

model Profile {
  id        String      @id @default(uuid())
  userId    String      @map("user_id")
  type      ProfileType
  name      String?     // For child's name
  dob       DateTime?
  gender    Gender?
  

  
  // Child specific
  weight    Float? // in kg
  height    Float? // in cm
  allergies String[]
  
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  mealPlans MealPlan[]
  measurements Measurement[]

  @@map("profiles")
}

model Measurement {
  id        String   @id @default(uuid())
  profileId String   @map("profile_id")
  weight    Float    // in kg
  height    Float    // in cm
  date      DateTime @default(now())
  
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@map("measurements")
}

model MealPlan {
  id              String   @id @default(uuid())
  profileId       String   @map("profile_id")
  weekNumber      Int      @map("week_number")
  budget          Float?   // Optional budget constraint
  ingredientsJson Json     @map("ingredients_json") // Storing recipes/ingredients structure
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@map("meal_plans")
}

model Transaction {
  id        String            @id @default(uuid())
  userId    String            @map("user_id")
  amount    Float
  currency  String            @default("IDR")
  status    TransactionStatus @default(PENDING)
  type      TransactionType
  metadata  Json?
  createdAt DateTime          @default(now()) @map("created_at")
  updatedAt DateTime          @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  shipments Shipment[]

  @@map("transactions")
}

model MealsPackage {
  id                   String   @id @default(uuid())
  name                 String
  description          String
  price                Float
  ageMinMonths         Int      @map("age_min_months")
  ageMaxMonths         Int      @map("age_max_months")
  location             String   // e.g., "Jakarta", "All Indonesia"
  category             String   // e.g., "Bubur", "Puree", "Snack", "Paket Lengkap"
  nutritionalBenefits  String[] @map("nutritional_benefits")
  stock                Int      @default(100)
  isActive             Boolean  @default(true) @map("is_active")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  carts        CartItem[]

  @@map("meals_packages")
}

model Cart {
  id        String     @id @default(uuid())
  userId    String     @unique @map("user_id")
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]

  @@map("carts")
}

model CartItem {
  id             String        @id @default(uuid())
  cartId         String        @map("cart_id")
  packageId      String?       @map("package_id") // Optional link to specific package
  productId      String?       @map("product_id") // Optional link to specific product ID if we had a Product model
  name           String        // Snapshot of product name
  price          Float         // Snapshot of price
  quantity       Int           @default(1)
  imageUrl       String?       @map("image_url") // Optional image
  
  cart           Cart          @relation(fields: [cartId], references: [id], onDelete: Cascade)
  mealsPackage   MealsPackage? @relation(fields: [packageId], references: [id])

  @@map("cart_items")
}

model Shipment {
  id            String         @id @default(uuid())
  transactionId String         @map("transaction_id")
  day           Int            // Day number (1-7)
  date          DateTime       // Scheduled delivery date
  status        ShipmentStatus @default(PENDING)
  notes         String?
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  transaction   Transaction    @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@map("shipments")
}

enum ShipmentStatus {
  PENDING
  PROCESSED
  SHIPPED
  DELIVERED
  CANCELLED
}
